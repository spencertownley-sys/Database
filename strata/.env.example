# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Pooled connection (PgBouncer, transaction mode) — used by the app at runtime.
#
# MUST be a NON-OWNER role. Table owners bypass RLS, so an app connecting as
# `postgres` has decorative tenant isolation and an isolation test suite that
# proves nothing. Locally, `CREATE_LOCAL_APP_ROLE=1 npm run db:migrate` gives
# `strata_app` this password.
DATABASE_URL=postgresql://strata_app:strata_app@127.0.0.1:5432/strata
# Direct connection — migrations only (DDL needs the owner). Never route DDL
# through the pooler, and never point the app at this role.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/strata

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never referenced from a Client Component.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=strata-files

# ---------------------------------------------------------------------------
# Redis (Upstash)
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Jobs (Inngest)
# ---------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Strata <no-reply@strata.app>"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
# Server-side pepper mixed into API key hashing. Rotating it invalidates every
# issued key, so treat it as a permanent per-environment secret.
API_KEY_PEPPER=dev-only-pepper-change-me
WEBHOOK_SIGNING_VERSION=v1

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
BULK_SYNC_THRESHOLD=500
VARIANT_SYNC_THRESHOLD=50
MAX_IMPORT_ROWS=50000

# ---------------------------------------------------------------------------
# Observability (optional in dev)
# ---------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
